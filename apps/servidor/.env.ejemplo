# ============================================================================
# Configuración de Balanza Mágica (copiar como .env o definir en cPanel)
# ============================================================================
NODE_ENV=production

# Base de datos MySQL creada en cPanel (el prefijo del usuario lo pone cPanel)
BD_HOST=localhost
BD_PUERTO=3306
BD_NOMBRE=usuario_balanza
BD_USUARIO=usuario_balanza
BD_CLAVE=una-clave-larga-y-secreta

# Clave para entrar al panel docente (mínimo 10 caracteres, no la compartas)
CLAVE_DOCENTE=cambia-esta-clave-docente

# Orígenes permitidos (separados por coma)
ORIGENES=https://balanza.profesoraevelyn.com
